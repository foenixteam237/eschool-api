// =============================================================================
// eSchool - Prisma Schema (Full ERP + Backend Alignment)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Enums ====================

enum UserRole {
  SUPERADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RETIRED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
  TRANSFERRED
}

enum GradeStatus {
  PENDING
  SUBMITTED
  REVIEWED
  PUBLISHED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  ON_LEAVE
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentType {
  TUITION
  ACTIVITY_FEE
  EXAM_FEE
  UNIFORM
  TRANSPORT
  OTHER
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ==================== Users & Auth / RBAC ====================

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  firstName String
  lastName  String
  role      UserRole   @default(STUDENT)
  status    UserStatus @default(ACTIVE)
  phone     String?
  avatar    String?

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  admin   Admin?
  teacher Teacher?
  student Student?
  parent  Parent?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  submittedTickets SupportTicket[]

  @@map("users")
}

model Admin {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("admins")
}

model School {
  id       String  @id @default(cuid())
  name     String  @unique
  code     String? @unique
  address  String?
  phone    String?
  email    String?
  ville    String?
  region   String?
  slogan   String?
  timezone String? @default("Africa/Douala")

  users          User[]
  teachers       Teacher[]
  students       Student[]
  classes        Class[]
  subscription   Subscription?
  supportTickets SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schools")
}

// ==================== School Year & Classes ====================

model SchoolYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]

  @@map("school_years")
}

model Class {
  id           String      @id @default(cuid())
  name         String
  level        String      @default("Secondaire")
  section      String?
  capacity     Int
  status       ClassStatus @default(ACTIVE)
  schoolYearId String
  schoolYear   SchoolYear  @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects           Subject[]
  students           Student[]
  grades             Grade[]
  attendance         Attendance[]
  timetable          Timetable[]
  teacherAssignments TeacherAssignment[]

  @@unique([schoolYearId, name, section])
  @@map("classes")
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  credits   Int      @default(3)
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons            Lesson[]
  grades             Grade[]
  teacherAssignments TeacherAssignment[]

  @@map("subjects")
}

// ==================== Teachers ====================

model Teacher {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId     String        @unique
  specialization String?
  qualifications String?
  status         TeacherStatus @default(ACTIVE)
  hireDate       DateTime      @default(now())

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes            Class[]
  lessons            Lesson[]
  gradeReports       GradeReport[]
  teacherAssignments TeacherAssignment[]

  @@map("teachers")
}

model TeacherAssignment {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("teacher_assignments")
}

// ==================== Students & Parents ====================

model Student {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId      String        @unique
  status         StudentStatus @default(ACTIVE)
  enrollmentDate DateTime      @default(now())

  classId String?
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parents     Parent[]
  grades      Grade[]
  attendance  Attendance[]
  payments    Payment[]
  assignments Assignment[]

  @@map("students")
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students Student[]

  @@map("parents")
}

// ==================== Academics & Grades ====================

model Lesson {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  duration  Int
  content   String?
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lessons")
}

model Grade {
  id        String      @id @default(cuid())
  score     Float
  maxScore  Float       @default(100)
  status    GradeStatus @default(PENDING)
  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId   String
  class     Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  reportId  String?
  report    GradeReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([studentId, subjectId, reportId])
  @@map("grades")
}

model GradeReport {
  id        String   @id @default(cuid())
  title     String
  period    String
  date      DateTime @default(now())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades Grade[]

  @@map("grade_reports")
}

// ==================== Attendance ====================

model Attendance {
  id        String           @id @default(cuid())
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, date])
  @@map("attendance")
}

// ==================== Payments & Transactions ====================

model Payment {
  id          String        @id @default(cuid())
  amount      Float
  type        PaymentType   @default(TUITION)
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime      @default(now())
  paidDate    DateTime?
  description String?
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  transactions Transaction[]

  @@map("payments")
}

model Transaction {
  id        String   @id @default(cuid())
  amount    Float
  method    String
  reference String?
  notes     String?
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

// ==================== Timetable ====================

model Timetable {
  id        String    @id @default(cuid())
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  classId   String
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([classId, dayOfWeek, startTime])
  @@map("timetable")
}

// ==================== Messages ====================

model Message {
  id         String   @id @default(cuid())
  subject    String
  content    String
  isRead     Boolean  @default(false)
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("messages")
}

// ==================== Assignments & Submissions ====================

model Assignment {
  id          String           @id @default(cuid())
  title       String
  description String
  dueDate     DateTime
  status      AssignmentStatus @default(PUBLISHED)
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id           String     @id @default(cuid())
  content      String
  score        Float?
  feedback     String?
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("submissions")
}

// ==================== Platform SaaS, Subscriptions & Support ====================

model Subscription {
  id             String   @id @default(cuid())
  schoolId       String   @unique
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan           String   @default("ANNUEL_STANDARD")
  status         String   @default("ACTIVE")
  amount         Float    @default(350000)
  currency       String   @default("XAF")
  durationMonths Int      @default(12)
  startDate      DateTime @default(now())
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("subscriptions")
}

model SupportTicket {
  id                String   @id @default(cuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submittedByUserId String
  submittedByUser   User     @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)
  subject           String
  description       String
  priority          String   @default("MEDIUM")
  status            String   @default("OPEN")
  adminResponse     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("support_tickets")
}

